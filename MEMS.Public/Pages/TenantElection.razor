@page "/{TenantSlug}"
@using System.Net
@using System.Net.Http.Json
@using MEMS.Public.Services
@using MEMS.Shared.DTOs
@inject HttpClient Http
@inject VotingGuideSessionService GuideService
@inject IConfiguration Config

<PageTitle>@(municipality?.Name ?? "Election") Candidates</PageTitle>

<div class="container py-4">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">@errorMessage</div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5 text-muted">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div>Loading election directory...</div>
        </div>
    }
    else if (municipality is null)
    {
        <div class="civic-card p-5 text-center my-4">
            <h4 class="fw-bold mb-2">Municipality Not Found</h4>
            <p class="text-muted mb-3">We couldn't find an active election directory for "<strong>@TenantSlug</strong>".</p>
            <a href="/" class="btn btn-civic-primary">Return to Municipalities</a>
        </div>
    }
    else
    {
        <div class="civic-hero mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(municipality.LogoUrl))
                {
                    <img src="@ResolveImage(municipality.LogoUrl)" alt="@municipality.Name logo"
                         onerror="this.style.display='none'" class="me-3 rounded bg-white p-1"
                         style="height: 60px; width: 60px; object-fit: cover;" />
                }
                <div>
                    <div class="small text-uppercase fw-semibold text-warning mb-1">@municipality.Province Municipal
                        Election</div>
                        <h1 class="h2 fw-bold mb-1">@municipality.Name</h1>
                        <span class="badge bg-light text-dark">
                            Election Date: @municipality.ElectionDate.ToString("MMMM d, yyyy")
                        </span>
                    </div>
                </div>
            </div>

            <div class="civic-card p-3 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted mb-1">Search Candidate</label>
                        <input class="form-control" placeholder="Type a candidate's name..." @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted mb-1">Filter by Office / Position</label>
                        <select class="form-select" @bind="selectedPositionId">
                            <option value="0">All Positions (@positions.Count)</option>
                            @foreach (var pos in positions)
                            {
                                <option value="@pos.PositionId">
                                    @pos.Name (@pos.SeatsAvailable seat@(pos.SeatsAvailable > 1 ? "s" : ""))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end pt-md-4">
                        <span class="text-muted small">
                            Showing <strong>@FilteredCandidates.Count()</strong> of @candidates.Count candidates
                        </span>
                    </div>
                </div>
            </div>

            @if (!FilteredCandidates.Any())
            {
                <div class="civic-card p-5 text-center">
                    <h5 class="fw-bold mb-1">No Matching Candidates</h5>
                    <p class="text-muted mb-3">Try clearing your search term or selecting a different position.</p>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => { searchTerm = string.Empty; selectedPositionId = 0; }">
                        Reset Filters
                    </button>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var cand in FilteredCandidates)
                    {
                        var isSelected = selectedCandidateIds.Contains(cand.CandidateId);
                        var posName = !string.IsNullOrWhiteSpace(cand.PositionName)
                            ? cand.PositionName
                            : positions.FirstOrDefault(p => p.PositionId == cand.PositionId)?.Name ?? "Candidate";

                        <div class="col-md-6 col-lg-4">
                            <div class="civic-card h-100 p-4 d-flex flex-column @(isSelected ? "civic-card-selected" : "")">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="civic-monogram me-3 position-relative overflow-hidden">
                                        <span>@GetInitials(cand.Name)</span>
                                        @if (!string.IsNullOrEmpty(cand.PhotoUrl))
                                        {
                                            <img src="@ResolveImage(cand.PhotoUrl)" alt="@cand.Name" onerror="this.style.display='none'"
                                                 class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" />
                                        }
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1 text-dark">@cand.Name</h5>
                                        <span class="civic-badge-position">@posName</span>
                                    </div>
                                </div>

                                <p class="text-secondary small flex-grow-1 mb-3">
                                    @(string.IsNullOrWhiteSpace(cand.Biography)
                                        ? "Candidate biography not yet provided."
                                        : cand.Biography)
                                </p>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="() => detailCandidate = cand">
                                        Details
                                    </button>
                                    <button
                                        class="btn btn-sm @(isSelected ? "btn-success" : "btn-civic-primary") flex-grow-1 fw-semibold"
                                        @onclick="() => ToggleCandidateAsync(cand.CandidateId)">
                                        @(isSelected ? "✓ In Voting Guide" : "+ Add to Voting Guide")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (detailCandidate is not null)
    {
        var modalPosName = !string.IsNullOrWhiteSpace(detailCandidate.PositionName)
            ? detailCandidate.PositionName
            : positions.FirstOrDefault(p => p.PositionId == detailCandidate.PositionId)?.Name;

        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header text-white" style="background-color: #0f294a;">
                        <div class="d-flex align-items-center">
                            <div class="civic-monogram civic-monogram-sm me-3 border border-light">
                                @GetInitials(detailCandidate.Name)
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold mb-0">@detailCandidate.Name</h5>
                                <small class="text-warning">@modalPosName &bull; @municipality?.Name</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white"
                                @onclick="() => detailCandidate = null"></button>
                    </div>
                    <div class="modal-body p-4">
                        <h6 class="text-uppercase text-muted small fw-bold mb-2">Candidate Statement</h6>
                        <p class="text-dark mb-4">
                            @(string.IsNullOrWhiteSpace(detailCandidate.Biography)
                                ? "No candidate statement provided."
                                : detailCandidate.Biography)
                        </p>

                        @if (!string.IsNullOrEmpty(detailCandidate.Email) || !string.IsNullOrEmpty(detailCandidate.Website))
                        {
                            <h6 class="text-uppercase text-muted small fw-bold mb-2">Contact &amp; Campaign Links</h6>
                            <div class="bg-light rounded-3 p-3 border small">
                                @if (!string.IsNullOrEmpty(detailCandidate.Email))
                                {
                                    <div class="mb-1">
                                        <strong>Email:</strong>
                                        <a href="mailto:@detailCandidate.Email" class="ms-1">@detailCandidate.Email</a>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(detailCandidate.Website))
                                {
                                    <div>
                                        <strong>Website:</strong>
                                        <a href="@detailCandidate.Website" target="_blank" rel="noopener"
                                           class="ms-1">@detailCandidate.Website</a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-light">
                        <button class="btn btn-secondary" @onclick="() => detailCandidate = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter] public string TenantSlug { get; set; } = string.Empty;

    private bool isLoading = true;
    private string? errorMessage;
    private MunicipalityDto? municipality;
    private List<PositionDto> positions = [];
    private List<CandidateDto> candidates = [];
    private List<int> selectedCandidateIds = [];
    private string searchTerm = string.Empty;
    private int selectedPositionId;
    private CandidateDto? detailCandidate;

    private IEnumerable<CandidateDto> FilteredCandidates => candidates
        .Where(c => selectedPositionId == 0 || c.PositionId == selectedPositionId)
        .Where(c => string.IsNullOrWhiteSpace(searchTerm) ||
                    c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        municipality = null;

        try
        {
            var slug = Uri.EscapeDataString(TenantSlug.Trim());
            municipality = await Http.GetFromJsonAsync<MunicipalityDto>($"api/municipalities/{slug}");

            if (municipality is not null)
            {
                positions = await Http.GetFromJsonAsync<List<PositionDto>>($"api/{municipality.Slug}/positions") ?? [];
                candidates = await Http.GetFromJsonAsync<List<CandidateDto>>($"api/{municipality.Slug}/candidates") ?? [];
                selectedCandidateIds = await GuideService.GetSelectedCandidateIdsAsync(municipality.Slug);
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            municipality = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load election directory: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleCandidateAsync(int candidateId)
    {
        if (municipality is null) return;
        await GuideService.ToggleCandidateAsync(municipality.Slug, candidateId);
        selectedCandidateIds = await GuideService.GetSelectedCandidateIdsAsync(municipality.Slug);
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private string ResolveImage(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return url;
        var adminBase = Config["AdminBaseUrl"]?.TrimEnd('/') ?? string.Empty;
        return $"{adminBase}{url}";
    }
}