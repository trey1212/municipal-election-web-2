@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark no-print">
        <div class="container">
            <a class="navbar-brand fw-bold">BC Ballot Builder</a>
            <div class="navbar-nav ms-auto flex-row gap-3">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Municipalities</NavLink>
                <NavLink class="nav-link fw-semibold text-warning" href="@GuideHref">Voting Guide</NavLink>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? currentSlug;

    private string GuideHref => string.IsNullOrEmpty(currentSlug)
        ? "/guide"
        : $"/{currentSlug}/guide";

    protected override void OnInitialized()
    {
        UpdateCurrentSlug();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentSlug();
        StateHasChanged();
    }

    private void UpdateCurrentSlug()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        if (string.IsNullOrEmpty(relative) || relative.Equals("guide", StringComparison.OrdinalIgnoreCase))
        {
            currentSlug = null;
            return;
        }

        currentSlug = relative.Split('/')[0];
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}