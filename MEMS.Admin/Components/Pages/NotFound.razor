@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found</PageTitle>

<div class="container py-5">
    <div class="civic-card p-5 text-center mx-auto" style="max-width: 520px;">
        <span class="badge bg-warning text-dark text-uppercase fw-semibold mb-2">404 Error</span>
        <h2 class="fw-bold mb-2">Page Not Found</h2>
        <p class="text-muted mb-4">Sorry, the administrative page you requested does not exist.</p>
        <a href="/admin" class="btn btn-civic-primary px-4">Return to Dashboard</a>
    </div>
</div>